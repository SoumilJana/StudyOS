# Study OS — Environment Variables
# Copy this file to .env and configure for your local environment:
# cp .env.example .env

# Supabase Project Configuration (Find in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI Configuration (Free Models Supported on Supabase Edge Proxy)
VITE_OPENROUTER_MODEL=google/gemma-4-31b-it:free
VITE_AI_PROVIDER=openrouter
